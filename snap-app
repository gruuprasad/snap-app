#!/usr/bin/env python3
import sys
import os
import time
import subprocess
import argparse

SNAP_DIR = "/tmp/agent-snaps"
os.makedirs(SNAP_DIR, exist_ok=True)

# Cleanup old snapshots, keep only latest 5
try:
    files = sorted(
        [os.path.join(SNAP_DIR, f) for f in os.listdir(SNAP_DIR) if f.startswith("app-state-") and f.endswith(".png")],
        key=os.path.getmtime,
        reverse=True
    )
    for f in files[5:]:
        os.remove(f)
except Exception:
    pass

SNAP_FILE = os.path.join(SNAP_DIR, f"app-state-{int(time.time())}.png")

TERMINAL_KEYWORDS = [
    "alacritty", "terminal", "kitty", "terminator", "tmux", "bash", "zsh", "fish",
    "xterm", "gnome-terminal", "konsole", "wezterm", "st", "urxvt", "antigravity", "code", "cursor"
]

def get_x11_windows():
    wins = []
    try:
        raw = subprocess.check_output(["xprop", "-root", "_NET_CLIENT_LIST"], stderr=subprocess.DEVNULL).decode()
        ids = [w.strip() for w in raw.split("#")[1].split(",") if w.strip()]
        for wid in ids:
            try:
                name = subprocess.check_output(["xdotool", "getwindowname", wid], stderr=subprocess.DEVNULL).decode().strip()
                if name:
                    wins.append((wid, name))
            except Exception:
                pass
    except Exception:
        pass
    return wins

def find_target_window(app_query=None):
    wins = get_x11_windows()
    if not wins:
        return None

    if app_query:
        query_lower = app_query.lower()
        for wid, name in reversed(wins):
            if query_lower in name.lower():
                return (wid, name)

    # Pick the most recent application window (browser, simulator, desktop app) ignoring terminals/editors
    for wid, name in reversed(wins):
        name_lower = name.lower()
        if not any(kw in name_lower for kw in TERMINAL_KEYWORDS):
            return (wid, name)

    return wins[-1] if wins else None

def capture_x11_silent(target_win=None):
    """
    Captures directly from the compositor's window pixmap buffer.
    ZERO window switching, ZERO focus changes, ZERO disruption.
    """
    if target_win:
        wid, name = target_win
        # Capture the window buffer directly by ID without activating or raising it
        subprocess.run(["import", "-window", wid, SNAP_FILE], check=True)
        return True
    else:
        subprocess.run(["import", "-window", "root", SNAP_FILE], check=True)
        return True

def capture_macos_silent(window_id=None):
    # macOS screencapture with -l <windowid> captures window directly in background
    if sys.platform == "darwin":
        cmd = ["screencapture", "-x"]
        if window_id:
            cmd.extend(["-l", str(window_id)])
        cmd.append(SNAP_FILE)
        subprocess.run(cmd, check=True)
        return True
    return False

def copy_to_clipboard(file_path):
    try:
        if subprocess.run(["which", "xclip"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            subprocess.run(["xclip", "-selection", "clipboard"], input=file_path.encode(), stderr=subprocess.DEVNULL)
        elif subprocess.run(["which", "wl-copy"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            subprocess.run(["wl-copy"], input=file_path.encode(), stderr=subprocess.DEVNULL)
        elif subprocess.run(["which", "pbcopy"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            subprocess.run(["pbcopy"], input=file_path.encode(), stderr=subprocess.DEVNULL)
    except Exception:
        pass

def main():
    parser = argparse.ArgumentParser(description="Completely silent background screenshot tool for AI agents")
    parser.add_argument("--app", "-a", help="Specific app/window title to snap (e.g. 'chrome', 'firefox')")
    parser.add_argument("--list", "-l", action="store_true", help="List available windows")
    args = parser.parse_args()

    if args.list:
        wins = get_x11_windows()
        print("Available windows:")
        for wid, name in wins:
            print(f"  {wid}: {name}")
        return

    success = False
    target = find_target_window(args.app)

    try:
        if sys.platform == "darwin":
            success = capture_macos_silent()
        else:
            success = capture_x11_silent(target)
    except Exception as e:
        try:
            subprocess.run(["import", "-window", "root", SNAP_FILE], check=True)
            success = True
        except Exception:
            success = False

    if success and os.path.exists(SNAP_FILE):
        copy_to_clipboard(SNAP_FILE)
        # Output ONLY the file path to stdout for the agent to parse
        print(SNAP_FILE)
        sys.exit(0)
    else:
        print("ERROR: Failed to capture background window buffer.", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
