#!/usr/bin/env python3
import sys
import os
import time
import subprocess
import argparse

SNAP_DIR = "/tmp/agent-snaps"
os.makedirs(SNAP_DIR, exist_ok=True)
TARGET_CACHE_FILE = os.path.join(SNAP_DIR, "target_window")

# Cleanup old snapshots, keep only latest 5
try:
    files = sorted(
        [os.path.join(SNAP_DIR, f) for f in os.listdir(SNAP_DIR) if f.startswith("app-state-") and f.endswith(".png")],
        key=os.path.getmtime,
        reverse=True
    )
    for f in files[5:]:
        os.remove(f)
except Exception:
    pass

SNAP_FILE = os.path.join(SNAP_DIR, f"app-state-{int(time.time())}.png")

def get_x11_windows():
    wins = []
    try:
        raw = subprocess.check_output(["xprop", "-root", "_NET_CLIENT_LIST"], stderr=subprocess.DEVNULL).decode()
        ids = [w.strip() for w in raw.split("#")[1].split(",") if w.strip()]
        for wid in ids:
            try:
                name = subprocess.check_output(["xdotool", "getwindowname", wid], stderr=subprocess.DEVNULL).decode().strip()
                if name:
                    wins.append((wid, name))
            except Exception:
                pass
    except Exception:
        pass
    return wins

def find_target_window(app_query=None):
    wins = get_x11_windows()
    if not wins:
        return None

    # 1. Use explicit query if provided
    if app_query:
        query_lower = app_query.lower()
        matches = [(wid, name) for wid, name in wins if query_lower in name.lower()]
        if matches:
            # Save as active session target
            try:
                with open(TARGET_CACHE_FILE, "w") as f:
                    f.write(app_query)
            except Exception:
                pass
            return matches[-1]
        
        print(f"⚠️  No window matching '{app_query}' found. Available windows:", file=sys.stderr)
        for wid, name in wins:
            print(f"   • {name}", file=sys.stderr)
        return None

    # 2. Check cached target from previous run
    if os.path.exists(TARGET_CACHE_FILE):
        try:
            with open(TARGET_CACHE_FILE, "r") as f:
                cached_query = f.read().strip().lower()
            if cached_query:
                matches = [(wid, name) for wid, name in wins if cached_query in name.lower()]
                if matches:
                    return matches[-1]
        except Exception:
            pass

    # 3. If no target specified and no valid cache, prompt for target
    print("ℹ️  No target window set. Specify a target window once (e.g. `snap-app \"Emulator\"` or `snap-app \"Firefox\"`).", file=sys.stderr)
    print("Available open windows:", file=sys.stderr)
    for wid, name in wins:
        print(f"   • {name}", file=sys.stderr)
    return None

def capture_x11_silent(target_win=None):
    if target_win:
        wid, name = target_win
        print(f"📸 Snapping target window: {name}", file=sys.stderr)
        subprocess.run(["import", "-window", wid, SNAP_FILE], check=True)
        return True
    return False

def copy_to_clipboard(file_path):
    try:
        if subprocess.run(["which", "xclip"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            subprocess.run(["xclip", "-selection", "clipboard"], input=file_path.encode(), stderr=subprocess.DEVNULL)
        elif subprocess.run(["which", "wl-copy"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            subprocess.run(["wl-copy"], input=file_path.encode(), stderr=subprocess.DEVNULL)
        elif subprocess.run(["which", "pbcopy"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            subprocess.run(["pbcopy"], input=file_path.encode(), stderr=subprocess.DEVNULL)
    except Exception:
        pass

def main():
    parser = argparse.ArgumentParser(description="Passive targeted background window screenshot tool for AI agents")
    parser.add_argument("target_hint", nargs="?", help="Optional app name or window title hint (e.g. 'Firefox', 'Emulator')")
    parser.add_argument("--app", "-a", help="Specific app/window title to snap")
    parser.add_argument("--list", "-l", action="store_true", help="List available windows")
    parser.add_argument("--clear", "-c", action="store_true", help="Clear the remembered target window")
    args = parser.parse_args()

    if args.clear:
        if os.path.exists(TARGET_CACHE_FILE):
            os.remove(TARGET_CACHE_FILE)
            print("Cleared remembered target window.", file=sys.stderr)
        return

    if args.list:
        wins = get_x11_windows()
        print("Available windows:")
        for wid, name in wins:
            print(f"  {wid}: {name}")
        return

    query = args.app or args.target_hint
    target = find_target_window(query)

    if not target:
        sys.exit(1)

    success = capture_x11_silent(target)

    if success and os.path.exists(SNAP_FILE):
        copy_to_clipboard(SNAP_FILE)
        # Output ONLY the file path to stdout for the agent to parse
        print(SNAP_FILE)
        sys.exit(0)
    else:
        print("ERROR: Failed to capture target window.", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
